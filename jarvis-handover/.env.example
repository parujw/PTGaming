# ตั้งค่าเหล่านี้ใน Vercel > Project > Settings > Environment Variables (ห้าม commit ค่าจริง)

# AI สรุปเสียง (จำเป็นถ้าจะใช้ AI)
ANTHROPIC_API_KEY=

# ทีม (ต้องตรงกับ teamId ใน config.js)
TEAM_ID=fo

# ทางเลือก 1: PIN ทีมแบบง่าย (ไม่ต้องใช้ Firebase)
TEAM_PIN=

# ทางเลือก 2: Firebase (บอร์ดร่วมทั้งทีม + บันทึกคนตอบ "รับ" จาก LINE)
# วาง JSON ของ service account ทั้งก้อนเป็นบรรทัดเดียว
FIREBASE_SERVICE_ACCOUNT=

# LINE Official Account (Messaging API)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# ไม่ต้องใส่ถ้าใช้ Firebase (พิมพ์ "jarvis id" ในกลุ่มแทน)
LINE_GROUP_ID=
