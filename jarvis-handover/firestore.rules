rules_version = '2';
// Only people whose Google email is listed in teams/{teamId}.members can read or write that team.
// Add members in Firebase Console > Firestore > teams > fo > members (array of lowercase emails).
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember(teamId) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/teams/$(teamId)).data.members;
    }
    match /teams/{teamId} {
      allow read: if isMember(teamId);
      allow write: if false; // members list is edited in the console only
      match /items/{itemId} {
        allow read, delete: if isMember(teamId);
        allow create, update: if isMember(teamId)
          && request.resource.data.keys().hasOnly(['room','guest','cat','pri','summary','action','due','done','doneBy','doneAt','createdAt','by'])
          && request.resource.data.summary is string && request.resource.data.summary.size() <= 600;
      }
      match /briefs/{briefId} {
        allow read, create, update: if isMember(teamId);
        allow delete: if false;
      }
      match /meta/{doc} {
        allow read: if isMember(teamId);
        allow write: if false; // written by the server (LINE webhook)
      }
    }
  }
}
